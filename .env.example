# Copy to .env locally. Never commit real credentials.
VITE_TWELVE_DATA_API_KEY=
# Broker credentials must be supplied through a server-side secret manager.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ENVIRONMENT=SANDBOX

# Upstox sandbox credentials — never commit real values
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
UPSTOX_ENVIRONMENT=SANDBOX
